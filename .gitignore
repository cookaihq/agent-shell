# OS
.DS_Store

# 本地临时 / 外部仓库克隆 / 工作底图（不入库）
tmp/
v1-*.png

# 工具产物
.playwright-mcp/
.codex/

# 本地配置
.claude/settings.local.json
.env

# 依赖与构建产物
node_modules/
dist/
web-dist/
release/
*.tsbuildinfo

# 发布镜像工作副本（独立 git 仓，由 scripts/publish-mirror.mjs 快照生成；私有仓不跟踪）
release-mirror/

# cnb.cool 凭据（明文 token，禁止提交）
.cnb-credentials

# 镜像仓推送用的 GitHub token（release-mirror/.github-token，明文 PAT，禁止提交）。
# 此规则随 publish-mirror.mjs 拷进镜像仓的 .gitignore，确保镜像仓也忽略它。
.github-token

# 工具生成的 worktree 目录（Claire/Clone），非源码
.claire/
.clone/
